---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "mb-4 p-5 rounded-lg border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:bg-slate-50 hover:border-blue-400 hover:shadow-md opacity-0 translate-y-5 animate-fadeInUp",
    className,
  ]}
>
  <slot />
</div>
