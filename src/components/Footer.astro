---
import { intro, socialLinks } from "../data/intro";
import { ui } from "../data/i18n";
---

<footer
  class="shrink-0 w-full text-center text-sm py-5 bg-white border-t border-slate-200 text-slate-600"
>
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <h5 class="text-lg mb-2 text-slate-900">
          <span class="lang-en">{ui.en.footer.getInTouch}</span>
          <span class="lang-ru">{ui.ru.footer.getInTouch}</span>
        </h5>
        <p>
          <a
            href="mailto:hackteck404@gmail.com"
            class="text-slate-900 no-underline hover:text-blue-800 transition-colors duration-300"
            >hackteck404@gmail.com</a
          >
        </p>
      </div>
      <div class="text-center flex items-center justify-center">
        <p class="text-slate-900 font-medium">{intro.name}</p>
      </div>
      <div class="text-center">
        <ul class="list-none p-0">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="text-slate-900 font-bold no-underline transition-colors duration-300 hover:text-blue-800 mr-2"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="lang-en">{link.label.en}</span>
                  <span class="lang-ru">{link.label.ru}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
