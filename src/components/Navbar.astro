---
import { ui } from "../data/i18n";

interface Props {
  activePage: string;
}

const { activePage } = Astro.props;
const base = import.meta.env.BASE_URL;

const navItems = [
  { key: "home" as const, href: `${base}`, page: "home" },
  { key: "about" as const, href: `${base}about/`, page: "about" },
  { key: "career" as const, href: `${base}career/`, page: "career" },
  { key: "projects" as const, href: `${base}projects/`, page: "projects" },
  {
    key: "certificates" as const,
    href: `${base}certificates/`,
    page: "certificates",
  },
  { key: "blogs" as const, href: `${base}blogs/`, page: "blogs" },
];
---

<nav
  class="nav-shell fixed top-5 left-0 right-0 z-[1000] mx-auto w-fit rounded-[10px] bg-white/90 backdrop-blur-md border border-slate-200/90 shadow-[0_10px_30px_rgba(15,23,42,0.08)] px-2.5 py-1.5 flex flex-wrap justify-center items-center gap-1"
  aria-label="Main navigation"
>
  <button
    id="nav-toggle"
    class="md:hidden p-2 text-slate-900"
    aria-label={ui.en.nav.toggle}
    aria-expanded="false"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>
  <ul
    id="nav-menu"
    class="hidden md:flex flex-col md:flex-row items-center list-none m-0 p-0"
  >
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "nav-link relative mx-1.5 my-1 md:my-0 px-3.5 py-2 rounded-xl font-medium no-underline overflow-hidden",
              activePage === item.page ? "is-active" : "",
            ]}
            aria-current={activePage === item.page ? "page" : undefined}
          >
            <span class="nav-link-label relative z-[1]">
              <span class="lang-en">{ui.en.nav[item.key]}</span>
              <span class="lang-ru">{ui.ru.nav[item.key]}</span>
            </span>
            <span class="nav-neon nav-neon-top" aria-hidden="true" />
            <span class="nav-neon nav-neon-bottom" aria-hidden="true" />
            <span class="nav-neon-glow" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ul>
  <div
    class="flex items-center gap-1 ml-1 pl-2 border-l border-slate-200"
    role="group"
    aria-label="Language"
  >
    <button
      type="button"
      data-lang-btn="en"
      class="lang-btn px-2 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-blue-800 transition-colors"
      aria-pressed="true"
    >
      EN
    </button>
    <button
      type="button"
      data-lang-btn="ru"
      class="lang-btn px-2 py-1 rounded-md text-xs font-semibold text-slate-600 hover:text-blue-800 transition-colors"
      aria-pressed="false"
    >
      RU
    </button>
  </div>
</nav>

<style>
  .lang-btn.lang-btn-active {
    color: #1e3a8a;
    background: #dbeafe;
  }

  .nav-link {
    color: #475569;
    transition:
      color 0.45s ease,
      text-shadow 0.45s ease,
      transform 0.45s ease;
  }

  .nav-link.is-active {
    color: #16a34a;
    font-weight: 600;
  }

  .nav-neon {
    position: absolute;
    right: 8%;
    width: 42%;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(148, 163, 184, 0.15) 20%,
      rgba(203, 213, 225, 0.95) 55%,
      rgba(241, 245, 249, 1) 100%
    );
    opacity: 0;
    transform: scaleX(0.35) translateX(10px);
    transform-origin: right center;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.55s ease,
      box-shadow 0.55s ease;
    pointer-events: none;
  }

  .nav-neon-top {
    top: 5px;
  }

  .nav-neon-bottom {
    bottom: 5px;
  }

  .nav-neon-glow {
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    background: radial-gradient(
      120% 90% at 78% 50%,
      rgba(203, 213, 225, 0.35) 0%,
      rgba(148, 163, 184, 0.12) 38%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #0f172a;
    text-shadow: 0 0 12px rgba(148, 163, 184, 0.55);
  }

  .nav-link:hover .nav-neon,
  .nav-link:focus-visible .nav-neon {
    opacity: 1;
    transform: scaleX(1) translateX(0);
    filter: blur(0.2px);
    box-shadow:
      0 0 6px rgba(226, 232, 240, 0.95),
      0 0 14px rgba(148, 163, 184, 0.65),
      0 0 22px rgba(100, 116, 139, 0.35);
  }

  .nav-link:hover .nav-neon-glow,
  .nav-link:focus-visible .nav-neon-glow {
    opacity: 1;
  }

  .nav-link.is-active .nav-neon {
    opacity: 0.7;
    transform: scaleX(0.85) translateX(0);
    box-shadow:
      0 0 6px rgba(187, 247, 208, 0.95),
      0 0 12px rgba(34, 197, 94, 0.4);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(134, 239, 172, 0.25) 20%,
      rgba(34, 197, 94, 0.9) 70%,
      rgba(220, 252, 231, 1) 100%
    );
  }

  .nav-link.is-active .nav-neon-glow {
    opacity: 0.4;
    background: radial-gradient(
      120% 90% at 78% 50%,
      rgba(187, 247, 208, 0.45) 0%,
      rgba(34, 197, 94, 0.14) 40%,
      transparent 72%
    );
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });
</script>
