---
import { Icon } from "astro-icon/components";

interface Props {
  label: string;
  icon?: string;
  iconType?: "iconify" | "local";
}

const { label, icon, iconType = "iconify" } = Astro.props;
---

{
  icon ? (
    <div class="skill-badge inline-flex flex-col items-center justify-center w-24 h-24 m-2 rounded-xl border border-slate-200 bg-white cursor-default transition-all duration-300 ease-out hover:border-blue-700 hover:bg-blue-50 hover:-translate-y-0.5 hover:shadow-[0_10px_24px_rgba(30, 58, 138,0.28)]">
      {iconType === "local" ? (
        <img
          src={`${import.meta.env.BASE_URL}${icon}`}
          alt={label}
          class="skill-icon w-10 h-10 object-contain grayscale transition-[filter,transform] duration-300"
        />
      ) : (
        <Icon
          name={icon}
          class="skill-icon w-10 h-10 grayscale transition-[filter,transform] duration-300"
        />
      )}
      <span class="skill-label text-xs text-slate-500 mt-2 text-center leading-tight px-1 transition-colors duration-300">
        {label}
      </span>
    </div>
  ) : (
    <span class="inline-block bg-white text-slate-600 border border-slate-200 px-3.5 py-1.5 m-1.5 rounded-full text-sm font-medium cursor-default transition-all duration-300 hover:border-blue-700 hover:bg-blue-50 hover:text-blue-900 hover:shadow-[0_8px_18px_rgba(30, 58, 138,0.22)]">
      {label}
    </span>
  )
}

<style>
  .skill-badge:hover .skill-icon {
    filter: grayscale(0);
    transform: scale(1.06);
  }

  .skill-badge:hover .skill-label {
    color: #1e3a8a;
  }
</style>
