---
interface Props {
  side: "left" | "right";
}

const { side } = Astro.props;
---

<div class={`timeline-item ${side} relative mb-2.5`}>
  <span
    class={`dot-${side} absolute top-[20%] w-3 h-3 bg-blue-800 rounded-full -translate-y-1/2 z-[1]`}
  ></span>
  <div
    class="card-timeline relative w-full max-w-[310px] z-[6] p-5 rounded-lg border border-slate-200 bg-white shadow-sm transition-all duration-300 hover:bg-slate-50 hover:border-blue-800/40 hover:shadow-md opacity-0 translate-y-5 animate-fadeInUp"
  >
    <slot />
  </div>
</div>
