---
interface Props {
  interactive?: boolean;
  /** Used for scroll animation targeting, e.g. "career" or "projects" */
  timelineId?: string;
}

const { interactive = false, timelineId = "flow" } = Astro.props;
---

<div
  class:list={[
    "timeline-vertical relative w-full max-w-3xl mx-auto",
    interactive && "timeline-interactive",
  ]}
  data-timeline={interactive ? timelineId : undefined}
>
  {
    interactive ? (
      <div class="timeline-track absolute top-0 left-1/2 -translate-x-1/2 w-0.5 h-full z-0 overflow-hidden rounded-full bg-blue-100">
        <div
          class="timeline-progress absolute left-0 bottom-0 w-full bg-gradient-to-t from-blue-900 via-blue-800 to-blue-700 origin-bottom"
          style="height: 0%;"
          data-timeline-progress
        />
      </div>
    ) : (
      <div class="timeline-line absolute top-0 left-1/2 w-0.5 h-full bg-blue-800 z-0" />
    )
  }
  <slot />
</div>
