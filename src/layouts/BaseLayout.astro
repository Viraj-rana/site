---
import { ViewTransitions } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ParticleNetwork from "../components/ParticleNetwork.astro";
import { intro, socialLinks } from "../data/intro";
import { ui } from "../data/i18n";
import "../styles/theme.css";
import "../styles/timeline.css";

interface Props {
  title: string;
  titleRu?: string;
  description?: string;
  descriptionRu?: string;
  activePage: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  titleRu = title,
  description = ui.en.meta.description,
  descriptionRu = ui.ru.meta.description,
  activePage,
  ogImage = "image_2.jpg",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://viraj-rana.github.io");
const canonicalURL = new URL(Astro.url.pathname, site).href;
const ogImageURL = new URL(
  `${import.meta.env.BASE_URL}${ogImage}`.replace(/\/{2,}/g, "/"),
  site,
).href;
const ogTitle = title.includes(intro.name) ? title : `${intro.name} | ${title}`;
const homeURL = new URL(import.meta.env.BASE_URL, site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${homeURL}#person`,
      name: intro.name,
      alternateName: [intro.names.ru, intro.names.hi],
      jobTitle: "Software Engineer, AI/ML Research Engineer",
      description: ui.en.home.description,
      url: homeURL,
      image: ogImageURL,
      email: socialLinks.find((l) => l.url.startsWith("mailto:"))?.url,
      sameAs: socialLinks.filter((l) => l.url.startsWith("http")).map((l) => l.url),
      knowsAbout: [
        "Artificial Intelligence",
        "Machine Learning",
        "Large Language Models",
        "Retrieval-Augmented Generation",
        "AI Agents",
        "LangGraph",
        "Python",
      ],
      alumniOf: [
        { "@type": "CollegeOrUniversity", name: "Gurugram University" },
        { "@type": "CollegeOrUniversity", name: "University of Penn" },
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${homeURL}#website`,
      name: `${intro.name} - Portfolio`,
      url: homeURL,
      inLanguage: ["en", "ru"],
      author: { "@id": `${homeURL}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-lang="en" class="scroll-smooth" data-page-title-en={title} data-page-title-ru={titleRu}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} data-desc-en={description} data-desc-ru={descriptionRu} />
    <title>{title}</title>
    <meta name="author" content={intro.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="theme-color" content="#1e3a8a" />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="sitemap" type="application/xml" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Open Graph / Telegram / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={intro.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={`${intro.name} - ${intro.title.en}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ru_RU" />

    <!-- twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${intro.name} - ${intro.title.en}`} />

    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <style is:global>
      html[data-lang="en"] .lang-ru {
        display: none !important;
      }
      html[data-lang="ru"] .lang-en {
        display: none !important;
      }
    </style>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("portfolio-lang");
          var lang = saved === "ru" || saved === "en" ? saved : "en";
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang);
        } catch {
          // intentionally empty
        }
      })();
    </script>
    <ViewTransitions />
  </head>
  <body
    class="min-h-screen m-0 pt-14 w-full font-sans bg-white text-slate-900 overflow-x-hidden flex flex-col"
    style="background-color:#ffffff;color:#0f172a;"
  >
    <ParticleNetwork />
    <Navbar activePage={activePage} />
    <main class="flex-1 pb-4 relative z-10">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <script is:inline>
      (function () {
        function applyLang(lang) {
          document.documentElement.setAttribute("data-lang", lang);
          document.documentElement.setAttribute("lang", lang);
          try {
            localStorage.setItem("portfolio-lang", lang);
          } catch {
            // intentionally empty
          }

          var titleEn = document.documentElement.getAttribute("data-page-title-en");
          var titleRu = document.documentElement.getAttribute("data-page-title-ru");
          if (titleEn && titleRu) {
            document.title = lang === "ru" ? titleRu : titleEn;
          }

          var meta = document.querySelector('meta[name="description"]');
          if (meta) {
            var desc =
              lang === "ru"
                ? meta.getAttribute("data-desc-ru")
                : meta.getAttribute("data-desc-en");
            if (desc) meta.setAttribute("content", desc);
          }

          document.querySelectorAll("[data-lang-btn]").forEach(function (btn) {
            var isActive = btn.getAttribute("data-lang-btn") === lang;
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
            btn.classList.toggle("lang-btn-active", isActive);
          });
        }

        if (!window.__portfolioLangBound) {
          window.__portfolioLangBound = true;
          document.addEventListener("click", function (e) {
            var btn = e.target && e.target.closest
              ? e.target.closest("[data-lang-btn]")
              : null;
            if (!btn) return;
            applyLang(btn.getAttribute("data-lang-btn"));
          });
        }

        function sync() {
          var current =
            document.documentElement.getAttribute("data-lang") || "en";
          applyLang(current);
        }

        document.addEventListener("astro:page-load", sync);
        sync();
      })();
    </script>
  </body>
</html>
