---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import SkillBadge from "../components/SkillBadge.astro";
import CertificationBadge from "../components/CertificationBadge.astro";
import {
  domains,
  technologies,
  languages,
  publications,
  featuredCertifications,
} from "../data/skills";
import { ui } from "../data/i18n";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title={ui.en.about.pageTitle}
  titleRu={ui.ru.about.pageTitle}
  description={ui.en.about.description}
  descriptionRu={ui.ru.about.description}
  activePage="about"
>
  <div class="max-w-7xl mx-auto px-4 mt-6">
    <div class="flex justify-center">
      <div class="w-full md:w-2/3">
        <Card>
          <div class="text-center">
            <h1 class="text-4xl md:text-5xl font-medium text-slate-900">
              Viraj Rana
            </h1>
            <p class="text-lg md:text-xl text-slate-600 mt-1">
              <span class="lang-en">{ui.en.about.subtitle}</span>
              <span class="lang-ru">{ui.ru.about.subtitle}</span>
            </p>
            {
              featuredCertifications.map((cert) => (
                <CertificationBadge
                  text={cert.text}
                  badgeUrl={cert.badgeUrl}
                  certificateUrl={cert.certificateUrl}
                  badgeAlt={cert.badgeAlt}
                  textSize={cert.textSize}
                />
              ))
            }
            <h2 class="text-left text-lg font-bold text-slate-900 mt-4">
              <span class="lang-en">{ui.en.about.heading}</span>
              <span class="lang-ru">{ui.ru.about.heading}</span>
            </h2>
            <p class="text-justify text-slate-600">
              <span class="lang-en">{ui.en.about.bio}</span>
              <span class="lang-ru">{ui.ru.about.bio}</span>
            </p>
          </div>
        </Card>
      </div>
    </div>

    <div class="flex justify-center">
      <div class="w-full md:w-2/3">
        <Card class="mt-3">
          <div class="text-center">
            <h2 class="text-2xl font-semibold text-slate-900">
              <span class="lang-en">{ui.en.about.skills}</span>
              <span class="lang-ru">{ui.ru.about.skills}</span>
            </h2>

            <h3 class="text-lg font-medium text-slate-600 mt-4 mb-2">
              <span class="lang-en">{ui.en.about.domains}</span>
              <span class="lang-ru">{ui.ru.about.domains}</span>
            </h3>
            <div>
              {
                domains.map((skill) => (
                  <>
                    <span class="lang-en">
                      <SkillBadge
                        label={skill.label.en}
                        icon={skill.icon}
                        iconType={skill.iconType}
                      />
                    </span>
                    <span class="lang-ru">
                      <SkillBadge
                        label={skill.label.ru}
                        icon={skill.icon}
                        iconType={skill.iconType}
                      />
                    </span>
                  </>
                ))
              }
            </div>

            <h3 class="text-lg font-medium text-slate-600 mt-6 mb-2">
              <span class="lang-en">{ui.en.about.technologies}</span>
              <span class="lang-ru">{ui.ru.about.technologies}</span>
            </h3>
            <div class="flex flex-wrap justify-center">
              {
                technologies.map((skill) => (
                  <SkillBadge
                    label={skill.label.en}
                    icon={skill.icon}
                    iconType={skill.iconType}
                  />
                ))
              }
            </div>
          </div>
        </Card>
      </div>
    </div>

    {
      publications.length > 0 && (
        <div class="flex justify-center">
          <div class="w-full md:w-2/3">
            <Card class="mt-3">
              <div class="text-center">
                <h2 class="text-2xl font-semibold text-slate-900">
                  Publications
                </h2>
                {publications.map((pub) => (
                  <details class="career-accordion group mt-4">
                    <summary class="cursor-pointer list-none text-center">
                      <h5 class="text-lg font-semibold text-slate-900">
                        {pub.title}
                      </h5>
                      <p class="text-sm text-slate-500">
                        {pub.journal} - {pub.date}
                      </p>
                      <a
                        href={pub.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`View ${pub.title} paper`}
                        class="text-slate-600 hover:text-blue-800 transition-colors duration-200 inline-block mt-1"
                        onclick="event.stopPropagation();"
                      >
                        <Icon
                          name="bi:file-earmark-text"
                          class="w-5 h-5 inline-block"
                        />
                      </a>
                      <svg
                        class="career-chevron mx-auto mt-2 w-5 h-5 text-blue-800 transition-transform duration-300"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M19 9l-7 7-7-7"
                        />
                      </svg>
                    </summary>
                    <div class="career-accordion-body text-justify mt-4 text-slate-600">
                      <p>{pub.abstract}</p>
                    </div>
                  </details>
                ))}
              </div>
            </Card>
          </div>
        </div>
      )
    }

    <div class="flex justify-center">
      <div class="w-full md:w-2/3">
        <Card class="mt-3">
          <div class="text-center">
            <h2 class="text-2xl font-semibold text-slate-900">
              <span class="lang-en">{ui.en.about.languages}</span>
              <span class="lang-ru">{ui.ru.about.languages}</span>
            </h2>
            <div class="mt-3">
              {
                languages.map((lang) => (
                  <>
                    <span class="lang-en">
                      <SkillBadge label={`${lang.flag} ${lang.name.en}`} />
                    </span>
                    <span class="lang-ru">
                      <SkillBadge label={`${lang.flag} ${lang.name.ru}`} />
                    </span>
                  </>
                ))
              }
            </div>
          </div>
        </Card>
      </div>
    </div>
  </div>
</BaseLayout>
