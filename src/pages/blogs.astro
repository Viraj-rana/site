---
import BaseLayout from "../layouts/BaseLayout.astro";
import { blogPosts, BLOG_ARCHIVE_URL } from "../data/blogs";
import { ui } from "../data/i18n";
import { Icon } from "astro-icon/components";
---

<BaseLayout
  title={ui.en.blogs.pageTitle}
  titleRu={ui.ru.blogs.pageTitle}
  description={ui.en.blogs.description}
  descriptionRu={ui.ru.blogs.description}
  activePage="blogs"
>
  <div class="max-w-3xl mx-auto px-4 mt-2 pb-14">
    <header class="text-center mb-8">
      <p
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold text-blue-800 bg-blue-50 border border-blue-100 mb-4"
      >
        <Icon name="bi:pencil-square" class="w-3.5 h-3.5" aria-hidden="true" />
        <span class="lang-en">{ui.en.blogs.kicker}</span>
        <span class="lang-ru">{ui.ru.blogs.kicker}</span>
      </p>
      <h1 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-2">
        <span class="lang-en">{ui.en.blogs.heading}</span>
        <span class="lang-ru">{ui.ru.blogs.heading}</span>
      </h1>
      <p class="text-sm md:text-base text-slate-600 max-w-xl mx-auto">
        <span class="lang-en">{ui.en.blogs.subtitle}</span>
        <span class="lang-ru">{ui.ru.blogs.subtitle}</span>
      </p>
    </header>

    {
      blogPosts.length === 0 ? (
        <p class="text-center text-slate-600 mt-8">
          <span class="lang-en">{ui.en.blogs.empty}</span>
          <span class="lang-ru">{ui.ru.blogs.empty}</span>
        </p>
      ) : (
        <>
          <ul class="space-y-0 list-none p-0 m-0" role="list">
            {blogPosts.map((post, index) => (
              <li
                class:list={[
                  "border-b border-slate-200 last:border-b-0",
                  index === 0 && "border-t",
                ]}
              >
                <a
                  href={post.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex gap-4 sm:gap-5 py-5 no-underline text-inherit items-start focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded-sm"
                >
                  <div class="shrink-0 w-28 h-24 sm:w-36 sm:h-28 rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
                    <img
                      src={post.image}
                      alt={post.imageAlt.en}
                      width="144"
                      height="112"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  </div>
                  <div class="min-w-0 flex-1 pt-0.5">
                    {post.date && (
                      <p class="text-xs font-medium text-slate-500 mb-1">
                        {post.date}
                      </p>
                    )}
                    <h2 class="text-base sm:text-lg font-semibold text-slate-900 leading-snug group-hover:text-blue-800 transition-colors">
                      <span class="lang-en">{post.title.en}</span>
                      <span class="lang-ru">{post.title.ru}</span>
                    </h2>
                    <p class="text-slate-600 mt-1.5 text-sm leading-relaxed line-clamp-2">
                      <span class="lang-en">{post.description.en}</span>
                      <span class="lang-ru">{post.description.ru}</span>
                    </p>
                    <span class="inline-flex items-center gap-1 mt-2 text-sm font-medium text-blue-800">
                      <span class="lang-en">{ui.en.blogs.readArticle}</span>
                      <span class="lang-ru">{ui.ru.blogs.readArticle}</span>
                      <Icon
                        name="bi:arrow-right"
                        class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5"
                      />
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          <div class="text-center mt-10">
            <a
              href={BLOG_ARCHIVE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-blue-800 text-blue-800 text-sm font-semibold no-underline hover:bg-blue-800 hover:text-white transition-colors"
            >
              <span class="lang-en">{ui.en.blogs.readMore}</span>
              <span class="lang-ru">{ui.ru.blogs.readMore}</span>
              <Icon name="bi:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </>
      )
    }
  </div>
</BaseLayout>