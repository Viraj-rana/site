---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import TimelineVertical from "../components/TimelineVertical.astro";
import TimelineYearMarker from "../components/TimelineYearMarker.astro";
import { careerEntries } from "../data/career";
import { ui } from "../data/i18n";

function getStartYear(dateRange: { en: string; ru: string }): number | null {
  const match = dateRange.en.match(/\d{4}/);
  return match ? parseInt(match[0]) : null;
}

const entriesByYear: {
  year: number | null;
  entries: typeof careerEntries;
}[] = [];
let currentYear: number | null = undefined as any;

for (const entry of careerEntries) {
  const year = getStartYear(entry.dateRange);
  if (year !== currentYear) {
    currentYear = year;
    entriesByYear.push({ year, entries: [] });
  }
  entriesByYear[entriesByYear.length - 1].entries.push(entry);
}
---

<BaseLayout
  title={ui.en.career.pageTitle}
  titleRu={ui.ru.career.pageTitle}
  activePage="career"
>
  <div class="max-w-7xl mx-auto px-4 mt-3 career-page">
    <h1
      class="text-center text-3xl md:text-4xl font-medium text-slate-900 mb-4"
    >
      <span class="lang-en">{ui.en.career.heading}</span>
      <span class="lang-ru">{ui.ru.career.heading}</span>
    </h1>
    <TimelineVertical interactive timelineId="career">
      {
        entriesByYear.map((group) => (
          <div>
            {group.year && <TimelineYearMarker year={group.year} />}
            {group.entries.map((entry) => {
              const hasDetails = entry.description || entry.bullets;
              return (
                <div class="timeline-item career-timeline-item relative mb-7">
                  <span class="career-timeline-dot" aria-hidden="true" />
                  <Card class="career-card">
                    {hasDetails ? (
                      <details class="career-accordion group">
                        <summary class="cursor-pointer list-none text-center">
                          <h5 class="career-card-title text-lg font-semibold text-slate-900 transition-colors duration-300">
                            <span class="lang-en">{entry.title.en}</span>
                            <span class="lang-ru">{entry.title.ru}</span>
                          </h5>
                          <p class="career-card-meta text-sm text-slate-500 flex items-center justify-center gap-2 transition-colors duration-300">
                            {entry.logo && (
                              <img
                                src={`${import.meta.env.BASE_URL}${entry.logo}`}
                                alt={entry.organization.en}
                                class="w-12 h-8 rounded object-contain bg-white px-2 py-0.5 border border-slate-200"
                              />
                            )}
                            <span>
                              <span class="lang-en">
                                {entry.organization.en}
                                {entry.dateRange.en && (
                                  <> &nbsp;&middot; {entry.dateRange.en}</>
                                )}
                              </span>
                              <span class="lang-ru">
                                {entry.organization.ru}
                                {entry.dateRange.ru && (
                                  <> &nbsp;&middot; {entry.dateRange.ru}</>
                                )}
                              </span>
                            </span>
                          </p>
                          {entry.project && (
                            <p class="text-sm text-slate-500 mt-1">
                              <span class="lang-en">
                                Project: {entry.project.en}
                              </span>
                              <span class="lang-ru">
                                Проект: {entry.project.ru}
                              </span>
                            </p>
                          )}
                          <svg
                            class="career-chevron mx-auto mt-2 w-5 h-5 text-blue-800 transition-transform duration-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19 9l-7 7-7-7"
                            />
                          </svg>
                        </summary>
                        <div class="career-accordion-body text-justify mt-4 text-slate-600">
                          {entry.bulletPrefix && (
                            <p>
                              <span class="lang-en">
                                {entry.bulletPrefix.en}
                              </span>
                              <span class="lang-ru">
                                {entry.bulletPrefix.ru}
                              </span>
                            </p>
                          )}
                          {entry.description &&
                            entry.description.map((paragraph, i) => (
                              <p class={i > 0 ? "mt-2" : ""}>
                                <span class="lang-en">{paragraph.en}</span>
                                <span class="lang-ru">{paragraph.ru}</span>
                              </p>
                            ))}
                          {entry.bullets && (
                            <ul
                              class:list={[
                                "list-disc text-left ml-5 space-y-1",
                                entry.bulletPrefix && "mt-1",
                              ]}
                            >
                              {entry.bullets.map((bullet) => (
                                <li>
                                  <span class="lang-en">{bullet.en}</span>
                                  <span class="lang-ru">{bullet.ru}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </details>
                    ) : (
                      <div class="text-center">
                        <h5 class="career-card-title text-lg font-semibold text-slate-900 transition-colors duration-300">
                          <span class="lang-en">{entry.title.en}</span>
                          <span class="lang-ru">{entry.title.ru}</span>
                        </h5>
                        <p class="career-card-meta text-sm text-slate-500 flex items-center justify-center gap-2 transition-colors duration-300">
                          {entry.logo && (
                            <img
                              src={`${import.meta.env.BASE_URL}${entry.logo}`}
                              alt={entry.organization.en}
                              class="w-12 h-8 rounded object-contain bg-white px-2 py-0.5 border border-slate-200"
                            />
                          )}
                          <span>
                            <span class="lang-en">
                              {entry.organization.en}
                              {entry.dateRange.en && (
                                <> &nbsp;&middot; {entry.dateRange.en}</>
                              )}
                            </span>
                            <span class="lang-ru">
                              {entry.organization.ru}
                              {entry.dateRange.ru && (
                                <> &nbsp;&middot; {entry.dateRange.ru}</>
                              )}
                            </span>
                          </span>
                        </p>
                      </div>
                    )}
                  </Card>
                </div>
              );
            })}
          </div>
        ))
      }
    </TimelineVertical>
  </div>
</BaseLayout>

<script>
  function initCareerTimeline() {
    const timeline = document.querySelector(
      '[data-timeline="career"]',
    ) as HTMLElement | null;
    if (!timeline) return;

    const progress = timeline.querySelector(
      "[data-timeline-progress]",
    ) as HTMLElement | null;
    const items = Array.from(
      timeline.querySelectorAll(".career-timeline-item"),
    ) as HTMLElement[];
    if (!progress || items.length === 0) return;

    if ((window as any).__careerTimelineBound) return;
    (window as any).__careerTimelineBound = true;

    const setActive = (activeIndex: number) => {
      items.forEach((item, index) => {
        item.classList.toggle("is-active", index === activeIndex);
      });
    };

    const update = () => {
      const rect = timeline.getBoundingClientRect();
      const viewportMid = window.innerHeight * 0.45;
      const start = window.scrollY + rect.top;
      const end = start + rect.height - window.innerHeight * 0.35;
      const current = window.scrollY;
      const raw = (current - start + window.innerHeight * 0.25) / (end - start || 1);
      const clamped = Math.max(0, Math.min(1, raw));

      progress.style.height = `${clamped * 100}%`;

      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;
      items.forEach((item, index) => {
        const itemRect = item.getBoundingClientRect();
        const itemMid = itemRect.top + itemRect.height / 2;
        const distance = Math.abs(itemMid - viewportMid);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });
      setActive(closestIndex);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }

  initCareerTimeline();
  document.addEventListener("astro:page-load", () => {
    (window as any).__careerTimelineBound = false;
    initCareerTimeline();
  });
</script>
