---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import TimelineVertical from "../components/TimelineVertical.astro";
import TimelineYearMarker from "../components/TimelineYearMarker.astro";
import { projects } from "../data/projects";
import { ui } from "../data/i18n";
import { Icon } from "astro-icon/components";

function getYear(date?: string): number | null {
  if (!date) return null;
  const match = date.match(/\d{4}/);
  return match ? parseInt(match[0]) : null;
}

const projectsByYear: { year: number | null; projects: typeof projects }[] = [];
let currentYear: number | null = undefined as any;

for (const project of projects) {
  const year = getYear(project.date);
  if (year !== currentYear) {
    currentYear = year;
    projectsByYear.push({ year, projects: [] });
  }
  projectsByYear[projectsByYear.length - 1].projects.push(project);
}
---

<BaseLayout
  title={ui.en.projects.pageTitle}
  titleRu={ui.ru.projects.pageTitle}
  activePage="projects"
>
  <div class="max-w-7xl mx-auto px-4 mt-3">
    <h1
      class="text-center text-3xl md:text-4xl font-medium text-slate-900 mb-4"
    >
      <span class="lang-en">{ui.en.projects.heading}</span>
      <span class="lang-ru">{ui.ru.projects.heading}</span>
    </h1>
    {
      projects.length === 0 ? (
        <p class="text-center text-slate-600 mt-8">
          <span class="lang-en">{ui.en.projects.empty}</span>
          <span class="lang-ru">{ui.ru.projects.empty}</span>
        </p>
      ) : (
        <TimelineVertical interactive timelineId="projects">
          {projectsByYear.map((group) => (
            <div>
              {group.year && <TimelineYearMarker year={group.year} />}
              {group.projects.map((project) => (
                <div class="timeline-item career-timeline-item relative mb-7">
                  <span class="career-timeline-dot" aria-hidden="true" />
                  <Card class="career-card">
                    <details class="career-accordion group">
                      <summary class="cursor-pointer list-none text-center">
                        <h5 class="career-card-title text-lg font-medium text-slate-900 transition-colors duration-300">
                          <span class="lang-en">{project.title.en}</span>
                          <span class="lang-ru">{project.title.ru}</span>
                        </h5>
                        {project.date && (
                          <p class="career-card-meta text-sm text-slate-500 transition-colors duration-300">
                            {project.date}
                          </p>
                        )}
                        {project.githubUrl && (
                          <a
                            href={project.githubUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`View ${project.title.en} GitHub repository`}
                            class="text-slate-600 hover:text-blue-800 transition-colors duration-200 inline-block mt-1"
                            onclick="event.stopPropagation()"
                          >
                            <Icon
                              name="bi:github"
                              class="w-6 h-6 inline-block"
                            />
                          </a>
                        )}
                        <svg
                          class="career-chevron mx-auto mt-2 w-5 h-5 text-blue-800 transition-transform duration-300"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M19 9l-7 7-7-7"
                          />
                        </svg>
                      </summary>
                      <div class="career-accordion-body text-justify mt-4 text-slate-600">
                        <p>
                          <span class="lang-en">{project.description.en}</span>
                          <span class="lang-ru">{project.description.ru}</span>
                        </p>
                        {project.bullets && (
                          <ul class="list-disc text-left ml-5 space-y-1 mt-1">
                            {project.bullets.map((bullet) => (
                              <li>
                                <span class="lang-en">{bullet.en}</span>
                                <span class="lang-ru">{bullet.ru}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                        {project.contributors && (
                          <p class="text-left mt-2">
                            <span class="lang-en">
                              <b>Other contributors:</b>{" "}
                              {project.contributors.en}
                            </span>
                            <span class="lang-ru">
                              <b>Другие участники:</b> {project.contributors.ru}
                            </span>
                          </p>
                        )}
                      </div>
                    </details>
                  </Card>
                </div>
              ))}
            </div>
          ))}
        </TimelineVertical>
      )
    }
  </div>
</BaseLayout>

<script>
  type FlowWindow = Window & { [key: string]: unknown };
  const win = window as FlowWindow;

  function initFlowTimelines() {
    const timelines = document.querySelectorAll(
      "[data-timeline]",
    ) as NodeListOf<HTMLElement>;

    timelines.forEach((timeline) => {
      const progress = timeline.querySelector(
        "[data-timeline-progress]",
      ) as HTMLElement | null;
      const items = Array.from(
        timeline.querySelectorAll(".career-timeline-item"),
      ) as HTMLElement[];
      if (!progress || items.length === 0) return;

      const key = timeline.getAttribute("data-timeline") || "flow";
      const boundKey = `__flowTimelineBound_${key}`;
      if ((win as Record<string, boolean>)[boundKey]) return;
      (win as Record<string, boolean>)[boundKey] = true;

      const setActive = (activeIndex: number) => {
        items.forEach((item, index) => {
          item.classList.toggle("is-active", index === activeIndex);
        });
      };

      const update = () => {
        const rect = timeline.getBoundingClientRect();
        const viewportMid = window.innerHeight * 0.45;
        const start = window.scrollY + rect.top;
        const end = start + rect.height - window.innerHeight * 0.35;
        const current = window.scrollY;
        const raw =
          (current - start + window.innerHeight * 0.25) / (end - start || 1);
        const clamped = Math.max(0, Math.min(1, raw));

        progress.style.height = `${clamped * 100}%`;

        let closestIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;
        items.forEach((item, index) => {
          const itemRect = item.getBoundingClientRect();
          const itemMid = itemRect.top + itemRect.height / 2;
          const distance = Math.abs(itemMid - viewportMid);
          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });
        setActive(closestIndex);
      };

      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    });
  }

  initFlowTimelines();
  document.addEventListener("astro:page-load", () => {
    // Allow re-bind after view transitions
    Object.keys(window).forEach((key) => {
      if (key.startsWith("__flowTimelineBound_")) {
        delete (win as Record<string, unknown>)[key];
      }
    });
    initFlowTimelines();
  });
</script>
